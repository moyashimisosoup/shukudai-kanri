rules_version = '2';

/* =========================================================
   Firestore セキュリティルール

   このファイルは記録用です。実際に効くのは Firebase Console
   （Firestore Database → ルール）に貼った内容なので、
   ここを変えたら Console にも貼り直してください。

   考え方
   ・内容の読み書きは静的クライアントから行うため、
     「あいことばを知っている＝そのグループの人」という前提で守る。
     保持期限の平文メタデータだけは Cloud Function が管理する。
   ・したがって守るべきは「あいことばを知らない人が、
     当てずっぽうや一覧取得でたどり着けないこと」。
   ・list（コレクションの一覧）は、アプリが一度も使わないので
     すべて禁止する。get だけ許せば、IDを知らない人は何も読めない。
   ========================================================= */
service cloud.firestore {
  match /databases/{database}/documents {

    /* グループのID。共有コードの SHA-256（64桁の16進）だけ。
       旧方式（合言葉をそのままIDにする版）は廃止した。中身に鍵を
       かけたので、鍵のない旧文書はそもそも読めない。 */
    function validHouseId(id) {
      return id.matches('[0-9a-f]{64}');
    }

    /* 保存できる欄。保持期限の4項目はサーバーの activity trigger だけが
       書きこむ。クライアントは作成時に指定できず、更新時にも変更できない。 */
    function onlyKnownStoredFields() {
      return request.resource.data.keys()
        .hasOnly(['config', 'state', 'configAt', 'stateAt', 'devices',
                  'lastActivityAt', 'expiresAt', 'retentionVersion',
                  'retentionEligibleAt']);
    }

    function onlyClientCreateFields() {
      return request.resource.data.keys()
        .hasOnly(['config', 'state', 'configAt', 'stateAt', 'devices']);
    }

    function retentionMetadataUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'lastActivityAt', 'expiresAt', 'retentionVersion', 'retentionEligibleAt'
      ]);
    }

    /* 管理者が削除処理に入れた共有IDは、古いオフライン端末が再接続しても
       文書を作り直せない。墓標の書き込みは管理用の Admin SDK だけが行う。 */
    function notRetired(houseId) {
      return !exists(/databases/$(database)/documents/household_tombstones/$(houseId));
    }

    /* config と state は、端末で鍵をかけた文字列でしか置かせない。
       ここを通ると、あいことばを知らない者はもちろん、
       このプロジェクトの管理者も中身を読めない。 */
    function sealedContent() {
      return (!('config' in request.resource.data)
              || request.resource.data.config is string)
          && (!('state' in request.resource.data)
              || request.resource.data.state is string);
    }

    /* ---------- グループのデータ ----------
       ID を知っている人だけが読み書きできる。
       list を許すとコレクションを丸ごと持って行かれるので禁止。 */
    match /households/{houseId} {
      allow get:            if request.auth != null && validHouseId(houseId);
      allow list:           if false;
      allow create:         if request.auth != null && validHouseId(houseId)
                            && notRetired(houseId) && onlyClientCreateFields() && sealedContent();
      allow update:         if request.auth != null && validHouseId(houseId)
                            && notRetired(houseId) && onlyKnownStoredFields() && sealedContent()
                            && retentionMetadataUntouched();
      allow delete:         if false;
    }

    /* 削除処理中・削除済みの印。共有コードから作ったIDを知る端末だけが
       1件を確認できる。内容は理由と時刻だけで、記録内容は入れない。 */
    match /household_tombstones/{houseId} {
      allow get:    if request.auth != null && validHouseId(houseId);
      allow list:   if false;
      allow create, update, delete: if false;
    }

    /* ---------- 登録グループ数（数だけ） ----------
       中身は count のみ。あいことばの手がかりは置かない。
       増やす方向にしか書きかえられないようにして、
       水増し・消去・巻き戻しを防ぐ。 */
    match /metrics/registrations {
      allow get:    if request.auth != null;
      allow list:   if false;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.auth != null
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    /* ---------- 同じグループを二重に数えないための目印 ----------
       ID があいことばの SHA-256。中身は登録日時だけ。
       ID を知っている＝あいことばを知っている人なので get は許すが、
       一覧は禁止する。これで「ハッシュの一覧が漏れて総当たりされる」
       という以前の弱点がなくなる。
       一度作ったら書きかえも削除もできない。 */
    match /metrics_households/{hash} {
      allow get:    if request.auth != null && hash.matches('[0-9a-f]{64}');
      allow list:   if false;
      allow create: if request.auth != null && hash.matches('[0-9a-f]{64}')
                    && request.resource.data.keys().hasOnly(['at']);
      allow update: if false;
      allow delete: if false;
    }

    /* ---------- 写真の受け渡し箱（一時） ----------
       宿題の一覧の写真を、親の端末から子の端末へその場で渡すための箱。
       写真の本体は各端末の中（IndexedDB）にあり、ここは運ぶだけ。
       グループの文書に入れないのは、1文書1MiBの上限に写真を乗せると
       家庭ぜんぶの同期が止まるため。

       中身はあいことばの鍵で包んだ文字列なので、IDを当てられても読めない。

       **このパスだけ delete を許す。** ほかは全部禁止しているが、
       ここは受け取った側が自分で片づけられる必要がある。消し忘れても
       expiresAt の TTL が消す（Console で TTL を設定すること）。 */
    match /photo_handoff/{houseId} {
      allow get:            if request.auth != null && validHouseId(houseId);
      allow list:           if false;
      allow create, update: if request.auth != null && validHouseId(houseId)
                            && notRetired(houseId)
                            && request.resource.data.keys()
                                 .hasOnly(['photo', 'at', 'from', 'expiresAt'])
                            && request.resource.data.photo is string
                            && request.resource.data.photo.size() < 900000
                            && request.resource.data.expiresAt is timestamp;
      allow delete:         if request.auth != null && validHouseId(houseId);
    }

    /* 上に書いていない場所は、すべて禁止 */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
